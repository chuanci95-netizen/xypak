<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">
            <ImageView
                android:id="@+id/inject_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_green"/>
        </FrameLayout>

        <TextView
            android:id="@+id/inject_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="功能"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/inject_switch"
        android:layout_width="44dp"
        android:layout_height="24dp"
        android:layout_marginTop="10dp">

        <View
            android:id="@+id/inject_track"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:background="@drawable/switch_track_off"/>

        <View
            android:id="@+id/inject_thumb"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="2dp"
            android:background="@drawable/switch_thumb"/>
    </FrameLayout>
</LinearLayout>
